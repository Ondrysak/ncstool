# Rust / Cargo
# Build artifacts
/target/
**/target/

# Backups created by rustfmt/rustc
*.rs.bk

# Coverage and profiling
*.profraw
*.profdata
*.gcda
*.gcno
*.gcov
*.lcov
/coverage/

# Logs and temporary files
*.log
*.tmp
*.temp

# Keep Cargo.lock by default (recommended for applications)
# If this repository contains library crates only, consider ignoring it instead.
!Cargo.lock

# Editor/IDE
.vscode/
.idea/
*.iml
*.code-workspace

# OS-specific
# macOS
.DS_Store
.AppleDouble
.LSOverride
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
# Linux
*~


# Reverse-engineering artifacts — regenerate locally, never commit (proprietary / large)
decompiled_validators/validator.wasm
decompiled_validators/validator.dcmp
decompiled_validators/validator.wat
decompiled_validators/*.wasm
decompiled_validators/*.dcmp
decompiled_validators/*.wat
# Local RE toolchain (kept outside repo, but guard anyway)
**/ghidra_*_PUBLIC/
**/jdk-*/
**/wabt-*/
*.ncs.bin
